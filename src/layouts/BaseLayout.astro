---
/**
 * CRITICAL: ensure that the "page" property value is defined in routes.js
 *
 * This layout is used for all pages, including the Mindbody widgets. It is important to keep the DOM structure   consistent across all pages to avoid hydration errors. The layout should not be changed without careful consideration of the impact on the Mindbody widgets and other components.
 */
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hreflang from "../components/Hreflang.astro";
import NextSteps from "../components/NextSteps.astro";
import { getSiteConfig } from "../data/config.ts";
// Switch back to linking CSS via HTML (instead of using Astro to embed below)
//import "../styles/global.css";
//import "../styles/mindbody.css";

const site = getSiteConfig();

const {
  title = site.siteName,
  description = site.description,
  lang = "en",
  page = null,
  fullBleed = false,
} = Astro.props;

const systemPages = ["register", "login", "account", "checkout"];
const noindex = systemPages.includes(page);

// Pages where the Studio footer should be pushed up to collapse the total combined footer
const mindbodyOffestPages = ["schedule", "login", "account", "checkout", "private-booking", "register"];
const footerOffset = mindbodyOffestPages.includes(page);

// Pages where next steps should be displayed
const nextStepsPages = ["about", "private", "teach", "classes", "pricing", "thankYou"];
const showNextSteps = nextStepsPages.includes(page);

// --- Title Formatting Logic ---
// 1. If it's the home page, or title equals/contains siteName, don't append siteName twice.
// 2. Otherwise, format as "<title> – <siteName>".
const isHome = page === "index" || title === site.siteName;
const formattedTitle = isHome
  ? (title.includes(site.siteName) ? title : site.siteName)
  : `${title} – ${site.siteName}`;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {noindex && <link rel="canonical" href={site.canonical} />}

    <!-- Hreflang automatically injected -->
    {page && <Hreflang page={page} />}

    <!-- Manifest -->
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Favicons -->
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon/icon-512.png" />
    <link rel="icon" type="image/png" href="/favicon/icon.png" />
    <link rel="icon" href="/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />

    <!-- Cascading Style Sheets -->
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/mindbody.css" />

    <!-- Allow pages to add extra <head> content -->
    <slot name="head" />

    <title>{formattedTitle}</title>
  </head>

  <body class="layout">
    <Header lang={lang} page={page} />

    <main class="layout-main">
      { fullBleed
        ? <slot /> // hero pages, landing pages
        : <div class="container">
            <slot />
            {showNextSteps && <NextSteps lang={lang} page={page} />}
          </div>
      }
    </main>

    <Footer lang={lang} footerOffset={footerOffset} />
  </body>
</html>

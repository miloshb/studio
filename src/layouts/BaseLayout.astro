---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const {
  title = "Studio Sun & Sea",
  description = "Yoga classes, private sessions, and teacher training with Studio Sun & Sea.",
  lang = "en"
} = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    <!-- Manifest -->
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Standard favicon -->
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16.png" />
    <link rel="icon" href="/favicon/favicon.ico" />

    <!-- Apple / iOS -->
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />

    <!-- Android / PWA -->
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon/icon-512.png" />

    <!-- Default PNG fallback -->
    <link rel="icon" type="image/png" href="/favicon/icon.png" />

    <title>{title}</title>

    <!-- Global styles -->
    <link rel="stylesheet" href="/styles/global.css" />
  </head>

  <body>
    <Nav lang={lang} />

    <main>
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>

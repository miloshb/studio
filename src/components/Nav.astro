---
import { TOP_NAV, getAlternateUrl } from "../data/routes.js";
const { lang, page } = Astro.props;
---

<nav class="nav container">
  <!-- Brand always links to the correct language root -->
  <a class="brand" href={lang === "de" ? "/de/" : "/en/"}>
    <img src="/logo/studio-sun-and-sea-logo.png"/>
    Studio Sun & Sea
  </a>

  <!-- Top Navigation (from unified routes.js) -->
  <div class="nav-links">
    {TOP_NAV[lang].map(item => (
      <a href={item.href}>{item.label}</a>
    ))}
  </div>

  <!-- Language Switcher (now flips to corresponding page) -->
  <div class="nav-lang">
    <a
      class={lang === "en" ? "active" : ""}
      href={getAlternateUrl(page, "de")}
      onclick="setLangPreference('en')"
    >
      EN
    </a>
    <span>·</span>
    <a
      class={lang === "de" ? "active" : ""}
      href={getAlternateUrl(page, "en")}
      onclick="setLangPreference('de')"
    >
      DE
    </a>
  </div>
</nav>

<script>
  function setLangPreference(lang) {
    localStorage.setItem('preferredLanguage', lang);
  }
</script>

<style>
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-md) 0;
    flex-shrink: 0;
  }

  .brand {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-text);
    display: flex;
    flex-wrap: nowrap;
    gap: 10px;
  }

  .nav-links a {
    margin-left: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-text-soft);
  }

  .nav-links a:hover {
    color: var(--color-text);
  }

  .nav-lang {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
  }

  .nav-lang a {
    color: var(--color-text-soft);
  }

  .nav-lang a.active {
    color: var(--color-text);
    font-weight: 600;
  }

  @media (max-width: 700px) {
    .nav {
      flex-direction: column;
      gap: var(--space-sm);
    }
  }
</style>

---
import { scheduleData } from "../data/schedule.ts";

const { lang = "en" } = Astro.props;

const dayHeader = {
  en: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
  de: ["Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"]
};

const TimeHeader = {
  en: "Time",
  de: "Zeit"
};

const dayKeys = dayHeader["en"];
const dayLabels = dayHeader[lang];
const timeLabel = TimeHeader[lang];
const START_TIMES = scheduleData.startTimes;
const CLASSES = scheduleData.classes;
const DAY_HEADER_OFFSET = scheduleData.dayHeaderOffset;

// Compute row heights from time differences
const ROW_HEIGHTS = START_TIMES.map((slot, i) => {
  if (i === 0) return DAY_HEADER_OFFSET;
  return slot.minutes - START_TIMES[i - 1].minutes;
});

const lastSlotStart = START_TIMES[START_TIMES.length - 1];
const firstSlotStart = START_TIMES[0];

const longestLastClass = CLASSES
  .filter(c => c.start === lastSlotStart.id)
  .reduce((max, c) => Math.max(max, c.duration), 0);

// Total grid height
const GRID_END =
  (lastSlotStart.minutes - firstSlotStart.minutes) +
  longestLastClass +
  DAY_HEADER_OFFSET;

// Helper: convert slot ID → absolute minute position
const getMinute = (id) => START_TIMES.find((t) => t.id === id).minutes;

// Build CSS grid rows
const gridRows = ROW_HEIGHTS.map((h) => `calc(${h} * var(--minute))`).join(" ");
---

<div class="schedule-grid"
  style={`--grid-end-time: ${GRID_END}; --grid-rows: ${gridRows};`}
>
  <!-- Left time column -->
  <div class="time-col">
    <div class="day">{timeLabel}</div>
    {START_TIMES.map((t) => <div class="time">{t.label}</div>)}
  </div>

  <!-- Day columns -->
  {dayKeys.map((day, index) => (
    <div class="day-col">
      <div class="day">{dayLabels[index]}</div>

      {CLASSES.filter((c) => c.day === day)
        .map((c) => {
        const start = getMinute(c.start) - START_TIMES[0].minutes + DAY_HEADER_OFFSET;
        const end = start + c.duration;
        const className = "_" + c.label.toLowerCase().replace(/[^\p{L}\p{N}]/gu, "");
        return (
          <a
            href={`/${lang}/schedule/`}
            class={`grid-element ${className}`}
            style={`grid-row: ${start} / ${end}`}
          >
            {c.label}
          </a>
        );
      })}
    </div>
  ))}

  <!-- Right time column -->
  <div class="time-col">
    <div class="day">{timeLabel}</div>
    {START_TIMES.map((t) => <div class="time">{t.label}</div>)}
  </div>
</div>

<style>
  .schedule-grid {
    display: grid;
    grid-template-columns: 40px repeat(7, 1fr) 40px;
    gap: 4px;
    --minute: 1px; /* 1 minute = 1px height */
    margin: 0 0 var(--space-sm) 0;
  }

  .time-col {
    display: grid;
    grid-template-rows: var(--grid-rows);
  }

  .day-col {
    display: grid;
    grid-template-rows: repeat(var(--grid-end-time), var(--minute));
    position: relative;
  }

  .day {
    text-align: center;
    font-weight: bold;
  }

  .grid-element {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    text-decoration: none;
    color: var(--color-text);
    padding: 4px;
  }

  ._yoga60     { background: #48AEB2; }
  ._yoga75     { background: #F2B138; }
  ._yoga90     { background: #B5DFE1; }
  ._262        { background: #CD98BE; }
  ._262express { background: #CD98BE; }
</style>

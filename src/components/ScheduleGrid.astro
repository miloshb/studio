---
const { lang = "en" } = Astro.props;

// Localized day headings
const dayLabels = {
  en: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
  de: ["Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"]
};

const days = dayLabels[lang];

// Times in minutes since midnight (Central European Time)
const classes = [
  // 08:30 Yoga 75
  { day: "Mon", start: 45, duration: 75, label: "Yoga 75" },
  { day: "Thu", start: 45, duration: 75, label: "Yoga 75" },
  { day: "Fri", start: 45, duration: 60, label: "Yoga 60" },

  // 10:00 Yoga 75
  { day: "Mon", start: 135, duration: 75, label: "Yoga 75" },
  { day: "Thu", start: 135, duration: 75, label: "Yoga 75" },
  { day: "Fri", start: 135, duration: 75, label: "Yoga 75" },

  // 12:30 Yoga 60
  { day: "Mon", start: 285, duration: 60, label: "Yoga 60" },
  { day: "Wed", start: 285, duration: 60, label: "Yoga 60" },
  { day: "Thu", start: 285, duration: 60, label: "Yoga 60" },
  { day: "Fri", start: 285, duration: 60, label: "26+2 Express" },

  // 14:15 Yoga 60
  { day: "Mon", start: 390, duration: 60, label: "Yoga 60" },
  { day: "Wed", start: 390, duration: 60, label: "26+2 Express" },
  { day: "Fri", start: 390, duration: 60, label: "Yoga 60" },

  // 14:45 Yoga 60
  { day: "Thu", start: 420, duration: 60, label: "Yoga 60" },
  { day: "Sat", start: 420, duration: 60, label: "Yoga 60" },
  { day: "Sun", start: 420, duration: 60, label: "Yoga 60" },

  // 16:00 Yoga 60/90
  { day: "Wed", start: 495, duration: 60, label: "Yoga 60" },
  { day: "Thu", start: 495, duration: 60, label: "26+2 Express" },
  { day: "Fri", start: 495, duration: 90, label: "Yoga 90" },
  { day: "Sat", start: 495, duration: 90, label: "26+2" },
  { day: "Sun", start: 495, duration: 90, label: "Yoga 90" },

  // 18:00 Yoga 75
  { day: "Fri", start: 615, duration: 75, label: "Yoga 75" },
  { day: "Sat", start: 615, duration: 75, label: "Yoga 75" },
  { day: "Sun", start: 615, duration: 75, label: "Yoga 75" },
];
---

<div class="schedule-grid">
  <div class="time-col">
    <div class="day">Time (CET)</div>
    <div class="time">08:30</div>
    <div class="time">10:00</div>
    <div class="time">12:30</div>
    <div class="time">14:15</div>
    <div class="time">14:45</div>
    <div class="time">16:00</div>
    <div class="time">18:00</div>
  </div>

  {days.map((day) => (
    <div class="day-col">
      <div class="day">{day}</div>

      {classes
        .filter((c) => c.day === day)
        .map((c) => (
          <a
            href="/en/schedule/"
            class={`grid-element _${c.label.toLowerCase().replace(/[^\p{L}\p{N}]/gu, "")}`}
            style={`grid-row: ${c.start} / ${c.start + c.duration}`}
          >
            {c.label}
          </a>
        ))}
    </div>
  ))}

  <div class="time-col">
    <div class="day">Time (CET)</div>
    <div class="time">08:30</div>
    <div class="time">10:00</div>
    <div class="time">12:30</div>
    <div class="time">14:15</div>
    <div class="time">14:45</div>
    <div class="time">16:00</div>
    <div class="time">18:00</div>
  </div>
</div>

<style>
  .schedule-grid {
    display: grid;
    grid-template-columns: 40px repeat(7, 1fr) 40px;
    gap: 4px;
    --minute: 1px; /* 1 minute = 1px height */
    --grid-end-time: 750
  }

  .schedule-grid .time-col {
    display: grid;
    grid-template-rows:
      calc( 45 * var(--minute))  // Empty space before first class
      calc( 75 * var(--minute))  // Slot 1: 08:30 Yoga 75
      calc( 90 * var(--minute))  // Slot 2: 10:00 Yoga 75
      calc(150 * var(--minute))  // Slot 3: 12:30 Yoga 60
      calc(105 * var(--minute))  // Slot 4a: 14:15 Yoga 60
      calc( 30 * var(--minute))  // Slot 4b: 14:45 Yoga 60
      calc( 75 * var(--minute))  // Slot 5: 16:00 Yoga 90
      calc(120 * var(--minute)); // Slot 6: 18:00 Yoga 75
  }

  .schedule-grid .day-col {
    display: grid;
    grid-template-rows: repeat(var(--grid-end-time), var(--minute));
    position: relative;
  }

  .grid-element {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    text-decoration: none;
    color: var(--color-text);
    padding: 4px;
  }

  ._yoga60     { background: #48AEB2; }
  ._yoga75     { background: #F2B138; }
  ._yoga90     { background: #B5DFE1; }
  ._262        { background: #CD98BE; }
  ._262express { background: #CD98BE; }
</style>

---
// src/components/PriceTable.astro
import { formatMultiCurrency } from "../utils/currency";

const { rows, locale, descLabel, priceLabel, rowLabelOverride = false } = Astro.props;

const descHeading = descLabel || (locale === "de-DE" ? "Dauer" : "Duration");
const priceHeading = priceLabel || (locale === "de-DE" ? "Preis" : "Price");

// Duration helper
// < 45 → treat as hours
// >= 45 → treat as minutes
function formatDuration(value: number, locale: string) {
  const isHours = value < 45;

  if (locale === "de-DE") {
    return isHours
      ? `${value} Stunden`
      : `${value} Minuten`;
  }

  return isHours
    ? `${value} hours`
    : `${value} minutes`;
}

export function htmlCurrencyCell(prices: string[]) {
  return (
    <td>
      {prices.map((price, index) => (
        <>
          {index > 0 && " / "}
          <strong>{price}</strong>
        </>
      ))}
    </td>
  );
}
---

<table>
  <thead>
    <tr>
      <th>{descHeading}</th>
      <th>{priceHeading}</th>
    </tr>
  </thead>
  <tbody>
    {rows.map((row) => {
      const rowLabel = rowLabelOverride ? row.label : formatDuration(row.duration, locale);
      const prices = formatMultiCurrency(row, locale);

      return (
        <tr>
          <td>{rowLabel}</td>
          {htmlCurrencyCell(prices)}
        </tr>
      );
    })}
  </tbody>
</table>

---
/**
 * Mindbody Registration Widget Component
 *
 * Props:
 * - widgetId: string (Mindbody widget ID)
 * - className: optional string for custom styling
 *
 *   <script src="https://widgets.mindbodyonline.com/javascripts/healcode.js" type="text/javascript"></script>
 *   <healcode-widget data-type="registrations" data-widget-partner="object" data-widget-id="9817563314de" data-widget-version="0" ></healcode-widget>
 */
const { widgetId, className = "" } = Astro.props;
---

<div class={`mindbody-widget-wrapper ${className}`}>
  <!-- Mindbody Registration widget begin -->
  <script src="https://widgets.mindbodyonline.com/javascripts/healcode.js" type="text/javascript"></script>
  <healcode-widget data-type="registrations" data-widget-partner="object" data-widget-id={widgetId} data-widget-version="0" ></healcode-widget>
  <!-- Mindbody Registration widget end -->
</div>

---
import { Image } from 'astro:assets';

// Props you allow the page to override
const {
  src,
  alt,
  widths = [400, 1080, 1600],
  sizes = "(max-width: var(--mobile-max-width)) 100vw, var(--maxwidth)",
  // thumbnail can be: true | "sm" | "md" | "lg"
  thumbnail = false,
  ...rest
} = Astro.props;

let finalSizes = sizes;
let finalWidths = widths;

// Thumbnail overrides
const sizeMap = {
  sm: "var(--thumbnail-width-sm)",
  md: "var(--thumbnail-width-md)",
  lg: "var(--thumbnail-width-lg)",
};
if (thumbnail) {
  // If thumbnail is boolean → default to "md"
  const sizeKey = typeof thumbnail === "string" ? thumbnail : "md";

  finalSizes = sizeMap[sizeKey] ?? sizeMap.md;
  finalWidths = [400, 1080];
}
---

<Image
  src={src}
  alt={alt}
  widths={finalWidths}
  sizes={finalSizes}
  {...rest}
/>

---
import { Image } from 'astro:assets';

// Props you allow the page to override
const {
  src,
  alt,
  widths = [400, 1080, 1600],
  sizes = "(max-width: var(--mobile-max-width)) 100vw, var(--maxwidth)",
  thumbnail = false,
} = Astro.props;

// Thumbnail overrides
const finalWidths = thumbnail ? [400, 1080] : widths;
const finalSizes = thumbnail ? "var(--thumbnail-width)" : sizes;
---

<Image
  src={src}
  alt={alt}
  widths={finalWidths}
  sizes={finalSizes}
/>

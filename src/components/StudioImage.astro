---
// src/components/StudioImage.astro
type SizeKey = "sm" | "md" | "lg";
type AspectKey = "square" | "portrait" | "headshot" | "landscape" | undefined;
interface Props {
  src: string;
  alt: string;
  widths?: number;
  sizes?: string;
  // thumbnail can be: true | "sm" | "md" | "lg"
  thumbnail?: SizeKey;
  aspect?: AspectKey;
  [key: string]: any;
}
const {
  src,
  alt,
  // Defaults for full-width images
  widths = [400, 1080, 1600],
  sizes = "(max-width: var(--mobile-max-width)) 100vw, var(--maxwidth)",
  thumbnail = false,
  aspect = null,
  ...rest
} = Astro.props;

let finalSizes = sizes;
let finalWidths = widths;
let wrapperStyle = "";
let thumbnailClass = "";

// Thumbnail overrides
const sizeMap:Record<SizeKey,string> = {
  sm: "var(--thumbnail-width-sm)",
  md: "var(--thumbnail-width-md)",
  lg: "var(--thumbnail-width-lg)",
};

if (thumbnail) {
  const size:SizeKey = typeof thumbnail === "string" ? thumbnail : "md";
  thumbnailClass = `thumbnail-${size}`
  finalSizes = sizeMap[size] ?? sizeMap.md;
  finalWidths = [400, 1080];
  wrapperStyle = `border-radius: var(--radius-xs)`;
}

// Aspect ratio class mapping
const aspectClass = aspect
  ? {
      square:    "aspect-square",
      portrait:  "aspect-portrait",
      headshot:  "aspect-headshot",
      landscape: "aspect-landscape",
    }[aspect]
  : "";
---

<div
  class={[aspectClass, thumbnailClass].filter(Boolean).join(" ")}
  style={wrapperStyle}
>
  <img
    src={src}
    alt={alt}
    sizes={finalSizes}
    loading="lazy"
    decoding="async"
    {...rest}
  />
</div>

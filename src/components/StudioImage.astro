---
import { Image } from 'astro:assets';

const {
  src,
  alt,
  // Defaults for full-width images
  widths = [400, 1080, 1600],
  sizes = "(max-width: var(--mobile-max-width)) 100vw, var(--maxwidth)",
  // thumbnail can be: true | "sm" | "md" | "lg"
  thumbnail = false,
  // aspect can be: "square" | "portrait" | "headshot" | "landscape" | undefined
  aspect = null,
  ...rest
} = Astro.props;

let finalSizes = sizes;
let finalWidths = widths;
let wrapperStyle = "";
let width = rest.width;
delete rest.width;

// Thumbnail overrides
const sizeMap = {
  sm: "var(--thumbnail-width-sm)",
  md: "var(--thumbnail-width-md)",
  lg: "var(--thumbnail-width-lg)",
};

if (thumbnail) {
  const sizeKey = typeof thumbnail === "string" ? thumbnail : "md";
  const thumbWidth = sizeMap[sizeKey] ?? sizeMap.md;
  width = width || thumbWidth;
  finalSizes = width;
  finalWidths = [400, 1080];
  wrapperStyle = `border-radius: var(--radius-md)`;
}

// Aspect ratio class mapping
const aspectClass = aspect
  ? {
      square:    "aspect-square",
      portrait:  "aspect-portrait",
      headshot:  "aspect-headshot",
      landscape: "aspect-landscape",
    }[aspect]
  : "";
---

<div class={aspectClass} style={wrapperStyle}>
  <Image
    src={src}
    alt={alt}
    widths={finalWidths}
    sizes={finalSizes}
    width={width}
    {...rest}
  />
</div>

---
// src/components/PriceCell.astro
import { formatMultiCurrency, type PriceData } from "../data/currency.ts";
import { getLocaleFromUrl, type SupportedLocale } from "../data/i18n.ts"

interface Props {
  // Accept either an array of pre-formatted strings OR the raw data object
  prices: string[] | PriceData;
  locale?: SupportedLocale; // Optional, fallback to en-US if missing
}
const { prices, locale: localeOverride } = Astro.props;
const currentLocale = localeOverride || getLocaleFromUrl(Astro.url);


const formattedPrices = Array.isArray(prices)
  ? prices
  : formatMultiCurrency(prices, currentLocale);
---

<td>
  {formattedPrices.map((price, index) => (
    <>
      {index > 0 && " / "}
      <strong>{price}</strong>
    </>
  ))}
  {formattedPrices.length > 0 && !Array.isArray(prices) && prices.billingUnit && (
    <span class="billing-unit">{prices.billingUnit}</span>
  )}
</td>

<style>
  .billing-unit {
    display: block;
    font-size: var(--text-xs);
  }
</style>

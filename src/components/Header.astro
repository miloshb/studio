---
// src/components/Header.astro
import { ROUTES, LANGS, HEADER_ROUTE_KEYS, getLangRoot, getLangUrl } from "../data/routes.js";
import { LANG_STORE_KEY } from "../data/constants.js";
import MindbodyLogin from "./widgets/MindbodyLoginLinkV1.astro";

const { lang, page } = Astro.props;
---

<header>
  <div class="header container">
    <!-- Brand always links to the correct language root -->
    <a class="brand" href={getLangRoot(lang)}>
      <img class="aspect-square" src="/favicon/favicon-48.png" alt="Studio Sun & Sea Logo" />
      Studio Sun & Sea
    </a>

    <!-- Header Navigation -->
    <div class="header-nav">
      {HEADER_ROUTE_KEYS.primary.map((key) => (
        <a href={ROUTES[key].href[lang]}>
          {ROUTES[key].nav[lang]}
        </a>
      ))}
      <div class="header-nav-2nd">
        {HEADER_ROUTE_KEYS.secondary.map((key) => (
          <a href={ROUTES[key].href[lang]}>
            {ROUTES[key].nav[lang]}
          </a>
        ))}
      </div>
    </div>

    <div class="header-tools">
      <MindbodyLogin />

      <!-- Language Switcher -->
      <div class="header-lang">
        {LANGS.map(code => (
          <>
            <a
              class={lang === code ? "active" : ""}
              href={getLangUrl(page, code)}
              data-lang={code}
            >
              {code.toUpperCase()}
            </a>
            {code !== LANGS.at(-1) && <span>·</span>}
          </>
        ))}
      </div>
    </div>
  </div>
</header>

<script define:vars={{ LANG_STORE_KEY }}>
  // Use Event Delegation: Attach one clean listener to the language selector parent block
  const langSwitcher = document.querySelector('.header-lang');

  if (langSwitcher) {
    langSwitcher.addEventListener('click', (event) => {
      // Find the closest anchor tag if they happen to click an inner border pixel
      const targetLink = event.target.closest('a[data-lang]');
      if (!targetLink) return;

      const chosenLang = targetLink.getAttribute('data-lang');
      if (chosenLang) {
        try {
          localStorage.setItem(LANG_STORE_KEY, chosenLang);
        } catch (e) {
          console.warn("Storage write blocked by browser configuration:", e);
        }
      }
    });
  }
</script>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-sm) 0;
    flex-shrink: 0;
    flex-wrap: wrap;
    gap: 0 var(--space-md);
  }

  /* ---------------------------
     HEADER NAVIGATION
  ---------------------------- */
  .header-nav {
    font-size: var(--text-md);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0 var(--space-sm);
  }

  .header-nav a {
    color: var(--color-text-soft);
    white-space: nowrap;
  }

  .header-nav a:hover {
    color: var(--color-text);
  }

  .header-nav-2nd {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: inherit;
  }

  /* ---------------------------
     TOOLS & LANGUAGE CONTROLS
  ---------------------------- */
  .header-tools {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: var(--space-sm);
  }

  .header-login {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xxs);
    min-width: var(--space-md);
    min-height: var(--space-md);
    contain: layout size style;
  }

  .header-lang {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    font-size: var(--text-xs);
    gap: var(--space-xxs);
  }

  .header-lang a {
    color: var(--color-text-soft);
  }

  .header-lang a.active {
    color: var(--color-text);
    font-weight: 600;
  }

  /* ---------------------------
     RESPONSIVE BREAKPOINTS
  ---------------------------- */
  @media (max-width: 900px) {
    /* Drop nav links to second header row */
    .header-nav {
      order: 2;
      width: 100%; /* Fallback for 'stretch' to maximize layout cross-browser compatibility */
    }
  }

  @media (width <= 600px) {
    .header-tools {
      flex-direction: column-reverse;
      align-items: flex-end;
      gap: var(--space-xxs);
    }
    .header-nav-2nd {
      display: none;
    }
  }
</style>

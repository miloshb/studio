---
import { HEADER_NAV, getAlternateUrl } from "../data/routes.js";
const { lang, page } = Astro.props;
---

<header>
  <div class="header container">
    <!-- Brand always links to the correct language root -->
    <a class="brand" href={lang === "de" ? "/de/" : "/en/"}>
      <img src="/logo/studio-sun-and-sea-logo.png" />
      Studio Sun & Sea
    </a>

    <!-- Header Navigation (from unified routes.js) -->
    <div class="header-nav">
      {HEADER_NAV[lang].map((item) => <a href={item.href}>{item.label}</a>)}
    </div>

    <!-- Language Switcher (now flips to corresponding page) -->
    <div class="header-lang">
      <a
        class={lang === "en" ? "active" : ""}
        href={getAlternateUrl(page, "de")}
        onclick="setLangPreference('en')"
      >
        EN
      </a>
      <span>·</span>
      <a
        class={lang === "de" ? "active" : ""}
        href={getAlternateUrl(page, "en")}
        onclick="setLangPreference('de')"
      >
        DE
      </a>
    </div>
  </div>
</header>

<script>
  function setLangPreference(lang) {
    localStorage.setItem("preferredLanguage", lang);
  }
</script>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-md) 0;
    flex-shrink: 0;
  }

  .brand {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--color-text);
    display: flex;
    flex-wrap: nowrap;
    gap: 10px;
    z-index: 1;
  }

  .header-nav a {
    margin-left: var(--space-md);
    font-size: var(--text-md);
    color: var(--color-text-soft);
  }

  .header-nav a:hover {
    color: var(--color-text);
  }

  .header-lang {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
  }

  .header-lang a {
    color: var(--color-text-soft);
  }

  .header-lang a.active {
    color: var(--color-text);
    font-weight: 600;
  }

  @media (max-width: 700px) {
    .header {
      flex-direction: column;
      gap: var(--space-sm);
    }
  }
</style>

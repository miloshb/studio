---
import { getSiteConfig } from "../data/config.ts";

const site = getSiteConfig();
const { lang } = Astro.props as { lang?: "en" | "de" };

const TEXT = {
  brand: {
    en: {
      title: "Breathe. Flow. Relax.",
      subtitle: "Mindful movement for a calm, connected life.",
      cta: "View Schedule",
      ctaHref: "/en/schedule-overview",
    },
    de: {
      title: "Atme. Fließe. Entspanne.",
      subtitle: "Achtsame Bewegung für ein ruhiges, verbundenes Leben.",
      cta: "Stundenplan ansehen",
      ctaHref: "/de/schedule-overview",
    },
  },
  corp: {
    en: {
      title: "Peace · Intention · Consciousness",
      subtitle: "Mindful movement for a calm, connected life.",
      cta: "Who we are?",
      ctaHref: "/en/about",
    },
    de: {
      title: "Frieden · Intention · Geist",
      subtitle: "Achtsame Bewegung für ein ruhiges, verbundenes Leben.",
      cta: "Wer sind wir?",
      ctaHref: "/de/about",
    },
  },
};

const copy = TEXT[site.mode]?.[lang ?? "en"] || TEXT.brand[lang ?? "en"];
---

<section class="hero">
  <!-- Bleeding Hero Background -->
  <div class="hero-bg-bleed"></div>

  <h1 class="hero-title">{copy.title}</h1>
  <p class="hero-subtitle">{copy.subtitle}</p>

  <a class="button" href={copy.ctaHref}>
    {copy.cta}
  </a>
</section>

<style>
  .hero {
    position: relative;
    flex: 1; /* expands to fill leftover vertical space */
    display: flex;
    flex-direction: column;
    justify-content: center; /* centers title/subtitle vertically */
    padding: var(--space-md);
    text-align: center;
    border-bottom: none;
  }

  .hero-bg-bleed {
    background: var(--color-bg) url("/images/hero/sunset-beach.webp") center/cover no-repeat;
    position: absolute;
    inset: 0;
    z-index: -1; /* Pushes it safely behind the text content */
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: var(--text-xxl);
    color: var(--color-text);
    margin: 0 0 var(--space-md) 0;
    font-weight: var(--font-weight);
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    color: var(--color-text-soft);
    margin: 0 auto var(--space-lg);
    max-width: var(--mobile-max-width);
    line-height: 1.5;
  }
</style>

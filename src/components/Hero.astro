---
const {
  title = "Breathe. Flow. Relax.",
  subtitle = "Mindful movement for a calm, connected life.",
  cta = "View Schedule",
  ctaHref = "/classes"
} = Astro.props;
---

<section class="hero">
  <h1 class="hero-title">{title}</h1>
  <p class="hero-subtitle">{subtitle}</p>

  <a href={ctaHref} class="hero-cta">
    {cta}
  </a>
</section>

<style>
  .hero {
    background: #F7EFEA url("/images/hero/sunset-beach.webp") center/cover no-repeat;
    padding: 140px 24px;
    text-align: center;
    border-bottom: 1px solid #E8DCCF;
  }

  .hero-title {
    font-family: "Cormorant Garamond", serif;
    font-size: 48px;
    color: #3A3A3C;
    margin: 0 0 16px 0;
    font-weight: 600;
  }

  .hero-subtitle {
    font-family: Inter, sans-serif;
    font-size: 20px;
    color: #6E6E73;
    margin: 0 0 32px 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.5;
  }

  .hero-cta {
    display: inline-block;
    padding: 12px 28px;
    background: #CFA79E;
    color: #3A3A3C;
    font-family: Inter, sans-serif;
    font-size: 16px;
    text-decoration: none;
    border-radius: 4px;
  }

  .hero-cta:hover {
    background: #c5978d;
  }
</style>

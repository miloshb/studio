---
const { lang } = Astro.props;

const TEXT = {
  en: {
    title: "Breathe. Flow. Relax.",
    subtitle: "Mindful movement for a calm, connected life.",
    cta: "View Schedule",
    ctaHref: "/en/schedule",
  },
  de: {
    title: "Atme. Fließe. Entspanne.",
    subtitle: "Achtsame Bewegung für ein ruhiges, verbundenes Leben.",
    cta: "Stundenplan ansehen",
    ctaHref: "/de/schedule",
  },
};

const copy = TEXT[lang] ?? TEXT.en;
---

<section class="hero">
  <!-- Bleeding Hero Background -->
  <div class="hero-bg-bleed"></div>

  <h1 class="hero-title">{copy.title}</h1>
  <p class="hero-subtitle">{copy.subtitle}</p>

  <a href={copy.ctaHref} class="hero-cta">
    {copy.cta}
  </a>
</section>

<style>
  .hero {
    flex: 1; /* expands to fill leftover vertical space */
    display: flex;
    flex-direction: column;
    justify-content: center; /* centers title/subtitle vertically */
    padding: var(--space-md);
    text-align: center;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-bg-bleed {
    background: var(--color-bg) url("/images/hero/sunset-beach.webp") center/cover no-repeat;
    position: absolute;
    /* Using Viewport Width (vw) units to burst out of the bounded parent limits */
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1; /* Pushes it safely behind the text content */
  }

  .hero-title {
    font-family: "Cormorant Garamond", serif;
    font-size: var(--text-xxl);
    color: var(--color-text);
    margin: 0 0 var(--space-sm) 0;
    font-weight: var(--font-weight);
  }

  .hero-subtitle {
    font-family: Inter, sans-serif;
    font-size: var(--text-lg);
    color: var(--color-text-soft);
    margin: 0 0 var(--space-lg) 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.5;
  }

  .hero-cta {
    display: inline-block;
    padding: var(--space-sm) var(--space-md);
    background: var(--color-accent);
    color: var(--color-text);
    font-family: Inter, sans-serif;
    font-size: var(--text-md);
    text-decoration: none;
    border-radius: 4px;
  }

  .hero-cta:hover {
    background: var(--color-accent-hover);
  }
</style>

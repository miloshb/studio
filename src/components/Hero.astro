---
const { lang } = Astro.props;

const TEXT = {
  en: {
    title: "Breathe. Flow. Relax.",
    subtitle: "Mindful movement for a calm, connected life.",
    cta: "View Schedule",
    ctaHref: "/en/schedule"
  },
  de: {
    title: "Atme. Fließe. Entspanne.",
    subtitle: "Achtsame Bewegung für ein ruhiges, verbundenes Leben.",
    cta: "Stundenplan ansehen",
    ctaHref: "/de/schedule"
  }
};

const copy = TEXT[lang] ?? TEXT.en;
---

<section class="hero">
  <!-- Bleeding Hero Background -->
  <div class="hero-bg-bleed"></div>

  <h1 class="hero-title">{copy.title}</h1>
  <p class="hero-subtitle">{copy.subtitle}</p>

  <a href={copy.ctaHref} class="hero-cta">
    {copy.cta}
  </a>
</section>

<style>
  .hero {
    text-align: center;
    border-bottom: 1px solid #E8DCCF;
    min-height: 100vh; /* Pushes the layout footer all the way to the screen bottom */
  }

  .hero-bg-bleed {
    background: #F7EFEA url("/images/hero/sunset-beach.webp") center/cover no-repeat;
    position: absolute;
    /* Using Viewport Width (vw) units to burst out of the bounded parent limits */
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    width: 100vw;
    height: 100%;
    z-index: -1; /* Pushes it safely behind the text content */
  }

  .hero-title {
    font-family: "Cormorant Garamond", serif;
    font-size: var(--text-xxl);
    color: #3A3A3C;
    margin: 0 0 16px 0;
    font-weight: 600;
  }

  .hero-subtitle {
    font-family: Inter, sans-serif;
    font-size: var(--text-lg);
    color: #6E6E73;
    margin: 0 0 32px 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.5;
  }

  .hero-cta {
    display: inline-block;
    padding: var(--space-sm) var(--space-md);
    background: #CFA79E;
    color: #3A3A3C;
    font-family: Inter, sans-serif;
    font-size: var(--text-md);
    text-decoration: none;
    border-radius: 4px;
  }

  .hero-cta:hover {
    background: #c5978d;
  }
</style>

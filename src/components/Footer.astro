---
import { FOOTER_ROUTE_KEYS, HEADER_ROUTE_KEYS, ROUTES } from "../data/routes.js";
import ExaliSeal from "./ExaliSeal.astro";
const { lang, footerOffset } = Astro.props;
const footerTopOffset = footerOffset ? "var(--offset-lg)" : "0px";
---

<footer class="footer">
  <div class="footer-inner container">
    <!-- Row 1: Navigation -->
    <div class="footer-nav">
      {FOOTER_ROUTE_KEYS.map((key) => (
        <a href={ROUTES[key].href[lang]}>
          {ROUTES[key].nav[lang]}
        </a>
      ))}
      <div class="header-in-footer-nav">
        {HEADER_ROUTE_KEYS.secondary.map((key) => (
          <a href={ROUTES[key].href[lang]}>
            {ROUTES[key].nav[lang]}
          </a>
        ))}
      </div>
    </div>

    <!-- Row 2: Left side -->
    <div class="footer-copy">
      © {new Date().getFullYear()}
      <a href="https://eireneintentiocitta.hr">Eirene Intentio Citta d.o.o.</a>
      All rights reserved.
    </div>

    <!-- Row 2: Right side -->
    <div class="footer-badge">
      <ExaliSeal />
    </div>
  </div>
</footer>

<style define:vars={{ footerTopOffset }}>
  .footer {
    padding: var(--space-xs) 0;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-soft);
    flex-shrink: 0;
    position: relative;
    top: var(--footerTopOffset);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: self-end;
  }

  /* ---------------------------
     ROW 1 — NAVIGATION
  ---------------------------- */
  .footer-nav {
    font-size: var(--text-sm);
    order: 1;
    flex: 1 1 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    column-gap: var(--space-sm);
  }

  .footer-nav a {
    color: var(--color-text-soft);
    white-space: nowrap;
  }

  .footer-nav a:hover {
    color: var(--color-text);
  }

  .header-in-footer-nav {
    display: none;
  }

  /* ---------------------------
     ROW 2 — COPYRIGHT + BADGE
  ---------------------------- */
  .footer-copy {
    order: 2;
    font-size: var(--text-sm);
  }

  .footer-badge {
    order: 3;
    margin-left: auto;
  }

  /* ---------------------------
     RESPONSIVE BREAKPOINTS
  ---------------------------- */
  @media (width <= 600px) {
    .header-in-footer-nav {
      display: contents;
    }
  }
</style>

---
import { FOOTER_NAV } from "../data/routes.js";
import ExaliSeal from "./ExaliSeal.astro";
const { lang, offset } = Astro.props;
---

<footer class="footer">
  <div class="footer-inner container">
    <!-- Row 1: Navigation -->
    <div class="footer-nav">
      {FOOTER_NAV[lang].map(item => (
        <a href={item.href}>{item.label}</a>
      ))}
    </div>

    <!-- Row 2: Left side -->
    <div class="footer-copy">
      © {new Date().getFullYear()} Studio Sun & Sea
    </div>

    <!-- Row 2: Right side -->
    <div class="footer-badge">
      <ExaliSeal />
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: var(--space-xs) 0;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-soft);
    flex-shrink: 0;
    position: relative;
    {offset ? `top: var(--offset-xl);` : ``}
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: self-end;
    row-gap: var(--space-xs);
  }

  /* ---------------------------
     ROW 1 — NAVIGATION
  ---------------------------- */
  .footer-nav {
    order: 1;
    flex: 1 1 100%;
    text-align: center;
  }

  .footer-nav a {
    margin: 0 var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-text-soft);
  }

  .footer-nav a:hover {
    color: var(--color-text);
  }

  /* ---------------------------
     ROW 2 — COPYRIGHT + BADGE
  ---------------------------- */
  .footer-copy {
    order: 2;
    font-size: var(--text-sm);
  }

  .footer-badge {
    order: 3;
    margin-left: auto;
  }

  /* ---------------------------
     MOBILE
  ---------------------------- */
  @media (max-width: 600px) {
    .footer-inner {
      text-align: center;
    }

    .footer-badge {
      margin-left: 0;
    }
  }
</style>

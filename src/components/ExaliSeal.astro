---
const { squareWithText = "false" } = Astro.props;
const exaliPixels = "65px"
---

<div class="exali-seal">
  <a rel="nofollow" href="https://www.exali.de/siegel/Studio_Sun_and_Sea" target="_blank"
    title="Weiter zur Berufshaftpflicht von Miloš Borojević"
  >
    <img src="https://www.exali.de/siegel/siegel_de-1_e05ffef407a7028871eb49b675c04acd.png"
      width="65"
      height="65"
      alt="Weiter zur Berufshaftpflicht von Miloš Borojević"
    />
  </a>
</div>

<style>
  --exali-seal-width: ${exaliPixels};

  .exali-seal {
    justify-self: end;
    {squareWithText && (position: absolute;)}
  }

  .exali-seal img {
    float: left;
  }
</style>

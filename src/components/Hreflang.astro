---
// src/components/Hreflang.astro
import { HREFLANG } from "../data/routes.ts";
import { getSiteConfig } from "../data/config.ts";
import { LANGS, DEFAULT_LANG } from "../data/i18n.ts";

const { page } = Astro.props;
const urls = HREFLANG[page];
const base = getSiteConfig().canonical;
---

{LANGS.map((lang) => (
  <link rel="alternate" hreflang={lang} href={base + urls[lang]} />
))}
<link rel="alternate" hreflang="x-default" href={base + urls[DEFAULT_LANG]} />

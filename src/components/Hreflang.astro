---
const { page } = Astro.props;

// Mapping EN ↔ DE equivalents
const map = {
  classes: { en: "/en/classes", de: "/de/classes" },
  private: { en: "/en/private", de: "/de/private" },
  teach: { en: "/en/teach", de: "/de/teach" },
  about: { en: "/en/about", de: "/de/about" },
  imprint: { en: "/en/imprint", de: "/de/impressum" },
  privacy: { en: "/en/privacy", de: "/de/datenschutz" },
  terms: { en: "/en/terms", de: "/de/agb" },
  waiver: { en: "/en/waiver", de: "/de/haftungsausschluss" },
  contact: { en: "/en/contact", de: "/de/kontakt" }
};

const urls = map[page];
const base = "https://studiosunandsea.com";
---

<link rel="alternate" hreflang="en" href={base + urls.en} />
<link rel="alternate" hreflang="de" href={base + urls.de} />
<link rel="alternate" hreflang="x-default" href={base + urls.en} />

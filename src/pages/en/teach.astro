import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout lang="en" page="teach" title="Teach – Studio Sun & Sea">
  <h1>Teach with Us</h1>

  <section>
    <p>
      Studio Sun & Sea is an international yoga and movement space rooted in clarity, kindness, and practice that meets people exactly where they are.
      If you teach with presence, awareness, and a spirit of connection, we’d love to hear from you.
    </p>
  </section>
  <section>
    <h2>What we’re looking for</h2>
    <ul>
      <li>
        Experienced teachers in
        <strong>yoga</strong>, <strong>movement</strong>,
        <strong>mindfulness</strong>, or <strong>barre</strong>
      </li>
      <li>A communication style grounded in non-violent, compassionate, and respectful language</li>
      <li>Clear, inclusive cueing and consent-based teaching</li>
      <li>English required; German is a plus</li>
      <li>Ability to teach online, in Studio (Germany), or at future retreats on the Dalmatian coast</li>
    </ul>
  </section>
  <section>
    <h2>What we offer</h2>
    <ul>
      <li>Small, engaged groups rather than mass classes</li>
      <li>Collaborative planning for themes, series, and workshops</li>
      <li>Fair compensation with transparent agreements</li>
      <li>Scheduling and booking support through Mindbody</li>
      <li>A calm, warm, and professional environment aligned with our studio values</li>
    </ul>
  </section>
  <section>
    <h2>Class formats we welcome</h2>
    <ul>
      <li>Vinyasa — calm, breath-led, focused</li>
      <li>Yin / Restorative</li>
      <li>Foundational / Aware classes</li>
      <li>Meditation / Breathwork</li>
      <li>Barre — strength, alignment, rhythm, mindful conditioning</li>
      <li>Specialty series (e.g. back care, mobility, athletes, etc.)</li>
    </ul>
  </section>
  <section>
    <h2>How to apply</h2>
    <p>
      Email <a href="mailto:milos@studiosunandsea.com;subject=Teaching at Studio Sun & Sea">milos@studiosunandsea.com</a><br />
      Subject: <em>Teaching at Studio Sun & Sea</em>
    </p>

    <p>Please include:</p>
    <ul>
      <li>Short bio (3-5 sentences)</li>
      <li>Teaching experience (years, styles, locations)</li>
      <li>Languages you teach in</li>
      <li>Link to a short teaching video or recorded class (if available)</li>
      <li>Your current location and availability</li>
    </ul>
  </section>
  <section>
    <h2>Next steps</h2>
    <p>
      If it’s a good fit, we’ll invite you for a short conversation, a sample class or teaching segment, and a discussion about schedule, rates, and collaboration.
    </p>
  </section>
</BaseLayout>

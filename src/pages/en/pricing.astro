---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout lang="en" page="pricing" title="Pricing – Studio Sun & Sea">
  <h1>Pricing</h1>

  <!-- Scheduled Classes -->
  <section>
    <h2>Scheduled Classes</h2>
    <table>
      <thead>
        <tr>
          <th>Option</th>
          <th>Price</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Single Class (60-90 minutes)</td>
          <td><strong>€20</strong> / <strong>$25</strong> / <strong>£18</strong></td>
        </tr>
        <tr>
          <td>Unlimited Week (one-time)</td>
          <td><strong>€55</strong></td>
        </tr>
        <tr>
          <td>Unlimited 2-Week Pass (one-time)</td>
          <td><strong>€95</strong></td>
        </tr>
        <tr>
          <td>Unlimited Monthly Subscription (recurring)</td>
          <td><strong>€120</strong></td>
        </tr>
      </tbody>
    </table>
    <p>
      The one-time unlimited passes are ideal for exploring Studio Sun & Sea and experiencing the full rhythm of practice. Designed for new students, each one-time pass can be purchased once per person.
    </p>
    <p>
      The Unlimited Monthly Subscription renews automatically and offers the best value for students who practice regularly, both in-studio and online.
    </p>
    <p>
      <strong>Kunga Yoga classes support service work.</strong> Five percent (5%) of proceeds is donated to charitable projects supported by the Kunga community. By practicing Kunga Yoga, you help support underserved populations around the world.
    </p>
    <p>
      Learn more about scheduled classes on the <a href="/en/classes">Classes</a> page.
    </p>
  </section>

  <!-- Class Pack -->
  <section>
    <h2>Class Pack</h2>
    <table>
      <thead>
        <tr>
          <th>Pack</th>
          <th>Price</th>
          <th>Validity</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>10-Class Pack</td>
          <td><strong>€180</strong></td>
          <td>18 months</td>
        </tr>
      </tbody>
    </table>
    <p>
      A flexible option for students who prefer to practice at their own rhythm. The 10-Class Pack offers a gentle discount without creating pressure to use it quickly.<br />
      With an 18-month validity period, there is plenty of time to attend classes whenever it fits your life — no stress, no countdown, and no need for extensions.
    </p>
  </section>

  <!-- Private Sessions -->
  <section>
    <h2>Private Sessions — One-to-One</h2>
    <table>
      <thead>
        <tr>
          <th>Duration</th>
          <th>Price</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>60 minutes</td><td><strong>€70</strong> / <strong>$80</strong> / <strong>£65</strong></td></tr>
        <tr><td>75 minutes</td><td><strong>€85</strong> / <strong>$95</strong> / <strong>£75</strong></td></tr>
        <tr><td>90 minutes</td><td><strong>€100</strong> / <strong>$115</strong> / <strong>£90</strong></td></tr>
        <tr><td>120 minutes</td><td><strong>€130</strong> / <strong>$150</strong> / <strong>£115</strong></td></tr>
      </tbody>
    </table>
    <p>
      Learn more about one-to-one private sessions on the
      <a href="/en/private#one-to-one">Private Yoga</a> page.
    </p>
  </section>

  <!-- Duet Sessions -->
  <section>
    <h2>Duet Private Sessions — Paired Practice</h2>
    <table>
      <thead>
        <tr>
          <th>Duration</th>
          <th>Price (for 2 students)</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>60 minutes</td><td><strong>€100</strong> / <strong>$115</strong> / <strong>£90</strong></td></tr>
        <tr><td>75 minutes</td><td><strong>€120</strong> / <strong>$135</strong> / <strong>£105</strong></td></tr>
        <tr><td>90 minutes</td><td><strong>€140</strong> / <strong>$160</strong> / <strong>£125</strong></td></tr>
        <tr><td>120 minutes</td><td><strong>€180</strong> / <strong>$205</strong> / <strong>£160</strong></td></tr>
      </tbody>
    </table>
    <p>
      Learn more about duet sessions on the
      <a href="/en/private#duet">Private Yoga</a> page.
    </p>
  </section>

  <!-- Small-Group Sessions -->
  <section>
    <h2>Small-Group Private Sessions — Up to 4 Students</h2>
    <table>
      <thead>
        <tr>
          <th>Duration</th>
          <th>Price (up to 4 students)</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>60 minutes</td><td><strong>€140</strong> / <strong>$160</strong> / <strong>£125</strong></td></tr>
        <tr><td>75 minutes</td><td><strong>€165</strong> / <strong>$190</strong> / <strong>£150</strong></td></tr>
        <tr><td>90 minutes</td><td><strong>€190</strong> / <strong>$220</strong> / <strong>£175</strong></td></tr>
        <tr><td>120 minutes</td><td><strong>€240</strong> / <strong>$275</strong> / <strong>£220</strong></td></tr>
      </tbody>
    </table>
    <p>
      Learn more about small-group private sessions on the
      <a href="/en/private#small-group">Private Yoga</a> page.
    </p>
  </section>

  <!-- Workshops -->
  <section>
    <h2>Workshops</h2>
    <table>
      <thead>
        <tr>
          <th>Duration</th>
          <th>Price</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>2 hours</td><td><strong>€55</strong> / <strong>$65</strong> / <strong>£50</strong></td></tr>
        <tr><td>3 hours</td><td><strong>€75</strong> / <strong>$85</strong> / <strong>£65</strong></td></tr>
        <tr><td>4 hours</td><td><strong>€95</strong> / <strong>$110</strong> / <strong>£85</strong></td></tr>
      </tbody>
    </table>
    <p>
      Learn more about workshop structure and themes on the
      <a href="/en/workshops">Workshops</a> page.
    </p>
  </section>

  <!-- Payment Options -->
  <section>
    <h2>Payment Options</h2>
    <p>
      Payments may be made via SEPA, Zelle, Venmo, Wise, or credit card through Mindbody.
      See full details on the <a href="/en/payment">Payment Options</a> page.
    </p>
  </section>

</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
//import PriceTable from "../../components/PriceTable.astro";
import { pricing } from "../../data/pricing";
---

<BaseLayout lang="en" page="pricing" title="Pricing – Studio Sun & Sea">
  <h1>Pricing</h1>

  <!-- Scheduled Classes -->
  <section>
    <h2>Scheduled Classes</h2>
    <table>
      <thead>
        <tr><th>Option</th><th>Price</th></tr>
      </thead>
      <tbody>
        <tr>
          <td>Single Class (60-90 minutes)</td>
          <td>
            <strong>{pricing.class.single.eur} €</strong> /
            <strong>{pricing.class.single.usd} $</strong> /
            <strong>{pricing.class.single.gbp} £</strong>
          </td>
        </tr>
        <tr>
          <td>Unlimited Week (one-time)</td>
          <td><strong>{pricing.intro.trialWeek} €</strong></td>
        </tr>
        <tr>
          <td>Unlimited 2-Week Pass (one-time)</td>
          <td><strong>{pricing.intro.trialTwoWeek} €</strong></td>
        </tr>
        <tr>
          <td>Unlimited Monthly Subscription (recurring)</td>
          <td><strong>{pricing.monthly.unlimited} €</strong></td>
        </tr>
      </tbody>
    </table>

    <p>
      The one-time unlimited passes are ideal for exploring Studio Sun & Sea and experiencing the full rhythm of practice. Designed for new students, each one-time pass can be purchased once per person.
    </p>
    <p>
      The Unlimited Monthly Subscription renews automatically and offers the best value for students who practice regularly, both in-studio and online.
    </p>
    <p>
      <strong>Kunga Yoga classes support service work.</strong> Five percent (5%) of proceeds is donated to charitable projects supported by the Kunga community. By practicing Kunga Yoga, you help support underserved populations around the world.
    </p>
    <p>
      Learn more about scheduled classes on the <a href="/en/classes">Classes</a> page.
    </p>
  </section>

  <!-- Class Pack -->
  <section>
    <h2>Class Pack</h2>
    <table>
      <thead>
        <tr><th>Pack</th><th>Price</th><th>Validity</th></tr>
      </thead>
      <tbody>
        <tr>
          <td>10-Class Pack</td>
          <td><strong>{pricing.class.tenPack.eur} €</strong></td>
          <td>{pricing.class.tenPack.validity} months</td>
        </tr>
      </tbody>
    </table>

    <p>
      A flexible option for students who prefer to practice at their own rhythm. The 10-Class Pack offers a gentle discount without creating pressure to use it quickly.<br />
      With an 18-month validity period, there is plenty of time to attend classes whenever it fits your life — no stress, no countdown, and no need for extensions.
    </p>
  </section>

  <!-- Private One-to-One Sessions -->
  <section>
    <h2>Private Sessions — One-to-One</h2>
    <p>
      Learn more about one-to-one private sessions on the
      <a href="/en/private#one-to-one">Private Yoga</a> page.
    </p>
  </section>

  <!-- Duet Sessions -->
  <section>
    <h2>Duet Private Sessions — Paired Practice</h2>
    <table>
      <thead>
        <tr><th>Duration</th><th>Price (for 2 students)</th></tr>
      </thead>
      <tbody>
        {pricing.duet.map((row) => (
          <tr>
            <td>{row.duration} minutes</td>
            <td>
              <strong>{row.eur} €</strong> /
              <strong>{row.usd} $</strong> /
              <strong>{row.gbp} £</strong>
            </td>
          </tr>
        ))}
      </tbody>
    </table>

    <p>
      Learn more about duet sessions on the
      <a href="/en/private#duet">Private Yoga</a> page.
    </p>
  </section>

  <!-- Small-Group Sessions -->
  <section>
    <h2>Small‑Group Private Sessions — Up to 4 Students</h2>
    <table>
      <thead>
        <tr><th>Duration</th><th>Price (up to 4 students)</th></tr>
      </thead>
      <tbody>
        {pricing.group.map((row) => (
          <tr>
            <td>{row.duration} minutes</td>
            <td>
              <strong>{row.eur} €</strong> /
              <strong>{row.usd} $</strong> /
              <strong>{row.gbp} £</strong>
            </td>
          </tr>
        ))}
      </tbody>
    </table>

    <p>
      Learn more about small‑group private sessions on the
      <a href="/en/private#small-group">Private Yoga</a> page.
    </p>
  </section>

  <!-- Workshops -->
  <section>
    <h2>Workshops</h2>
    <table>
      <thead>
        <tr><th>Duration</th><th>Price</th></tr>
      </thead>
      <tbody>
        {pricing.workshop.map((row) => (
          <tr>
            <td>{row.duration} hours</td>
            <td>
              <strong>{row.eur} €</strong> /
              <strong>{row.usd} $</strong> /
              <strong>{row.gbp} £</strong>
            </td>
          </tr>
        ))}
      </tbody>
    </table>

    <p>
      Learn more about workshop structure and themes on the
      <a href="/en/workshops">Workshops</a> page.
    </p>
  </section>

  <!-- Payment Options -->
  <section>
    <h2>Payment Options</h2>
    <p>
      Payments may be made via SEPA, Zelle, Venmo, Wise, or credit card through Mindbody.
      See full details on the <a href="/en/payment">Payment Options</a> page.
    </p>
  </section>

</BaseLayout>

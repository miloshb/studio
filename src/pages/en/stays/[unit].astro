---
// src/pages/en/stays/[unit].astro
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { guides } from "../../../data/stays/guides/index.ts";
import { units } from "../../../data/stays/units/index.ts";
import { info, debug } from "../../../data/config.ts";

import type { UnitKey } from "../../../data/stays/units/index.ts";
import type { UnitConfig } from "../../../data/stays/unitType.ts";
import type { Language } from "../../../data/config.ts";

export interface Props {
  unit: UnitConfig;
  lang: Language;
}

// Generate static paths AND pass props to the page
export async function getStaticPaths() {
  return (Object.keys(units) as UnitKey[]).map((id) => ({
    params: { unit: id },
    props: { unit: units[id], lang: "en" },
  }));
}

// Access props passed from getStaticPaths()
const { unit, lang } = Astro.props;

  info &&console.log("INFO: Astro.props =", Astro.props);
  debug && console.log("DEBUG: Astro.props.unit =", Astro.props.unit);

if (!unit) {
  console.error("ERROR: unit is undefined inside component");
  throw new Error("unit is undefined inside component");
}

if (info) {
  console.log("INFO: unit.id =", unit.id);
  console.log("INFO: unit.location =", unit.location);
}

const booking = {
  airbnb: "https://airbnb.com/h/studiosunandsea" + unit.id,
  booking: "",
  vrbo: "",
};
const email = unit.id + "@StudioSunAndSea.com";
// Load correct guide based on unit.location
const guide = guides[unit.location.guide];

// Auto-load photos from public/images/stays/<UnitID>/
const allPhotos = import.meta.glob("/public/images/stays/**/*.jpg", { eager: true });
const photos = Object.fromEntries(
  Object.entries(allPhotos).filter(([path]) =>
    path.includes(`/public/images/stays/${unit.id}/`)
  )
);
---

<BaseLayout lang={lang} page="stays" title={unit.name}>
  <h1>{unit.name} – Stay at Studio Sun & Sea</h1>

  <section>
    <p>{unit.description[lang].short}</p>
  </section>

  <!-- Long Description -->
  {unit.description?.[lang]?.long && (
    <section>
      <h2>About This Stay</h2>
      <p>{unit.description[lang].long}</p>
    </section>
  )}

  <!-- Booking Links -->
  <section>
    <h2>Book This Stay</h2>
    <ul>
      {booking.airbnb && (
        <li><a href={booking.airbnb}>Airbnb</a></li>
      )}
      {booking.booking && (
        <li><a href={booking.booking}>Booking.com</a></li>
      )}
      {booking.vrbo && (
        <li><a href={booking.vrbo}>VRBO</a></li>
      )}
    </ul>
  </section>

  <!-- Rooms + Beds -->
  <section>
    <h2>Rooms & Sleeping Arrangements</h2>

    {unit.rooms.map((room) => (
      <div class="room-block">
        <h3>{room.name}</h3>

        {room.beds && (
          <ul>
            {room.beds.map((bed) => (
              <li>
                {bed.type} — sleeps {bed.sleeps}
              </li>
            ))}
          </ul>
        )}
      </div>
    ))}
  </section>

  <!-- Directions -->
  {unit.directions?.[lang] && (
    <section>
      <h2>Directions</h2>
      <p>{unit.directions[lang]}</p>
    </section>
  )}

  <!-- Local Guide (Generic Rendering) -->
  <section>
    <h2>Local Guide</h2>

    {Object.entries(guide[lang]).map(([category, items]) =>
      items.length > 0 && (
        <div class="guide-block">
          <h3>{category.charAt(0).toUpperCase() + category.slice(1)}</h3>
          <ul>
            {items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      )
    )}
  </section>

  <!-- Photos -->
  <section>
    <h2>Photos</h2>
    <div class="photo-grid">
      {Object.keys(photos).map((src) => (
        <img src={src.replace("/public", "")} alt={`${unit.name} photo`} />
      ))}
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Operator from "../../components/Operator.astro";
import StudioImage from "../../components/StudioImage.astro";
import MindbodyProspectV1 from "../../components/widgets/MindbodyProspectV1.astro";
import SocialLinks from "../../components/SocialLinks.astro";
---

<BaseLayout lang="en" page="contact" title="Contact">
  <h1>Contact</h1>

  <section>
    <p>
      If you’d like to get in touch, you can reach Studio Sun & Sea by email or through the form below. We are happy to answer questions about classes, private sessions, collaborations, or anything else you may be curious about.
    </p>
  </section>

  <section class="contact">
    <StudioImage
      src='/images/classes/yoga-class-sukhasana-urdhva-hastasana-400.webp'
      alt="Sukhāsana Ūrdhva Hastāsana"
      thumbnail="lg"
      class="thumbnail-right"
    />
    <Operator lang="en" heading="Studio Sun & Sea" short email="info@studiosunandsea.com" />
    <SocialLinks />
  </section>

  <MindbodyProspectV1 widgetId="986524514de" />
</BaseLayout>

<style>
  .contact :global(svg) {
    width: var(--text-xl);
    height: var(--text-xl);
  }
</style>

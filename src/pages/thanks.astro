---
import { LANGS, ROUTES } from "../data/routes.js";
import { LANG_STORE_KEY } from "../data/constants.js";

const debug = true; // Set to true to show debug info

// Query params
const { searchParams } = Astro.url;
const query = searchParams.toString();
const qs = query ? `?${query}` : "";

// Automatically checks the browser header against your config's supported languages
const browserLang = Astro.preferredLocale;

// Or get a ranked list of all languages the browser requested that your site supports
const fallbackOptions = Astro.preferredLocaleList;

// Language preference
const langCookie = Astro.cookies.get("lang")?.value;
// doesn't work anyway.
//const browserLang = Astro.request.headers.get("accept-language")?.slice(0,2);
const lang = langCookie || (browserLang === "de" ? "de" : "en");

// Redirect to localized page
const thankYouPath = ROUTES.thankYou.href[lang];
//return Astro.redirect(`${thankYouPath}${qs}`);
---

<script define:vars={{ LANGS, LANG_STORE_KEY}}>
  function getCurrentQuery() {
    return window.location.search;
  }
</script>

{debug && (
  <p>
    query: {query}<br />
    qs: {qs}<br />
    currentQuery: {`getCurrentQuery()`}<br />
    langCookie: {langCookie}<br />
    browserLang: {browserLang}<br />
    fallbackOptions: {fallbackOptions}<br />
    lang: {lang}<br />
    thankYouPath: {thankYouPath}<br />
  </p>
)}

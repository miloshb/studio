    <StudioImage
      src='/images/classes/yoga-class-sukhasana-urdhva-hastasana-400.webp'
      alt="Sukhāsana Ūrdhva Hastāsana"
      thumbnail="lg"
      class="thumbnail-right"
    />
    <h2>Studio Sun & Sea</h2>
    <p>
      <strong>Inhaber:</strong> Miloš Borojević<br />
      Pfarrtannen 7<br />
      49808 Lingen, Deutschland<br />
      <strong>E-Mail:</strong>
      <a href="mailto:info@studiosunandsea.com">info@studiosunandsea.com</a>
    </p>
  </section>

  <section>
    <MindbodyProspectV1 widgetId="986524614de" />

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Operator from "../../components/Operator.astro";
import StudioImage from "../../components/StudioImage.astro";
import MindbodyProspectV1 from "../../components/widgets/MindbodyProspectV1.astro";
---

<BaseLayout lang="de" page="contact" title="Kontakt">
  <h1>Kontakt</h1>

  <section>
    <p>
      Wenn Sie Kontakt aufnehmen möchten, erreichen Sie Studio Sun & Sea per E-Mail oder über das untenstehende Formular. Wir beantworten gerne Fragen zu Kursen, Privatstunden, Kooperationen oder allem, was Sie sonst interessiert.
    </p>
  </section>

  <section>
    <StudioImage
      src='/images/classes/yoga-class-sukhasana-urdhva-hastasana-400.webp'
      alt="Sukhāsana Ūrdhva Hastāsana"
      thumbnail="lg"
      class="thumbnail-right"
    />
    <Operator lang="de" heading="Studio Sun & Sea" short email="info@studiosunandsea.com" />
  </section>

  <section>
    <MindbodyProspectV1 widgetId="986524614de" />
  </section>
</BaseLayout>

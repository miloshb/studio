---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MindbodyScheduleV2 from "../../components/widgets/MindbodyScheduleV2.astro";
import TimezoneLabel from "../../components/TimezoneLabel.astro";
---

<BaseLayout lang="de" page="schedule" title="Stundenplan – Studio Sun & Sea">
  <section class="timezone-notice">
    <strong>⚠️ Wichtiger Buchungshinweis für internationale Kund:innen</strong><br />
    Alle Kursbuchungen über das untenstehende Mindbody-Widget werden ausschließlich in
    <TimezoneLabel lang="de" client:load /> angezeigt. Bitte ermitteln Sie Ihren lokalen Zeitzonen-Unterschied entsprechend, bevor Sie Reservierungen vornehmen.
  </section>

  <section class="schedule-page container">
    <MindbodyScheduleV2 widgetId="985347614de" />
  </section>
</BaseLayout>

<style>
  .timezone-notice {
    border-left: 4px solid var(--color-accent);
    padding-left: var(--space-xs);
    color: var(--color-text-soft);
    font-size: var(--text-xs);
    position: relative;
    z-index: 1;
    width: 85%;
  }

  #timezone-label {
    font-weight: bolder;
  }
</style>
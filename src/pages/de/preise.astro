---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hreflang from "../../components/Hreflang.astro";
---

<BaseLayout lang="de" page="pricing" title="Preise – Studio Sun & Sea">
  <head slot="head">
    <Hreflang page="pricing" />
  </head>

  <h1>Preise</h1>

  <section>
    <h2>Geplante Kurse</h2>
    <ul>
      <li>60-90 Minuten: <strong>20 €</strong> / <strong>25 $</strong> / <strong>18 £</strong></li>
    </ul>
  </section>

  <section>
    <h2>Private Sessions</h2>
    <ul>
      <li>60 Minuten: <strong>70 €</strong> / <strong>80 $</strong> / <strong>65 £</strong></li>
      <li>75 Minuten: <strong>85 €</strong> / <strong>95 $</strong> / <strong>75 £</strong></li>
      <li>90 Minuten: <strong>100 €</strong> / <strong>115 $</strong> / <strong>90 £</strong></li>
      <li>120 Minuten: <strong>130 €</strong> / <strong>150 $</strong> / <strong>115 £</strong></li>
    </ul>
  </section>

  <section>
    <h2>Workshops</h2>
    <ul>
      <li>3 Stunden: <strong>75 €</strong> / <strong>85 $</strong> / <strong>65 £</strong></li>
      <li>4 Stunden: <strong>95 €</strong> / <strong>110 $</strong> / <strong>85 £</strong></li>
    </ul>
  </section>

  <section>
    <h2>Zahlungsoptionen</h2>
    <p>
      Zahlungen können per SEPA, Zelle, Venmo, Wise oder per Kreditkarte über Mindbody erfolgen.
      Alle Details findest du auf der Seite <a href="/de/zahlung">Zahlungsoptionen</a>.
    </p>
  </section>

</BaseLayout>

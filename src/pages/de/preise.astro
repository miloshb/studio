---
// src/pages/de/preise.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import PriceTable from "../../components/PriceTable.astro";
import PriceCell from "../../components/PriceCell.astro";
import { pricing } from "../../data/pricing";

const angebote = [
  { label: "Schnupperstunde (einmalig)", eur: pricing.intro.trialClass },
  { label: "Schnupperwoche – Unbegrenzte Woche (einmalig)", eur: pricing.intro.trialWeek },
  { label: "2-Wochen-Pass – Unbegrenzt (einmalig)", eur: pricing.intro.trialTwoWeek },
];

const monatsabo = [
  { label: "Unbegrenzter Monat (Abo)", ...pricing.membership.unlimitedMonth }
];

const geplanteKurse = [
  { label: "Einzelstunde (60-90 Minuten)", ...pricing.class.single }
];
---

<BaseLayout lang="de" page="pricing" title="Preise – Studio Sun & Sea">
  <h1>Preise</h1>

  <!-- Schnupperangebote -->
  <section>
    <h2>Schnupperangebote</h2>
    <PriceTable rows={angebote} rowLabelOverride descLabel="Angebot" />
    <p>
      Die Schnupperangebote sind einmalig pro Person buchbar und ideal, um Studio Sun & Sea kennenzulernen.
    </p>
    <p>
      <strong>Kunga Yoga unterstützt soziale Projekte.</strong> Fünf Prozent (5%) der Einnahmen aus Kunga-Yoga-Kursen wird an gemeinnützige Initiativen der Kunga-Gemeinschaft gespendet.
    </p>
    <p>
      Mehr Informationen zu den regulären Kursen findest du auf der Seite
      <a href="/de/classes">Kurse</a>.
    </p>
  </section>

  <!-- Monatsabo -->
  <section>
    <h2>Monatsabo</h2>
    <PriceTable rows={monatsabo} rowLabelOverride descLabel="Option" />
    <p>
      Das Monatsabo verlängert sich automatisch und bietet den besten Wert für regelmäßige Praxis - sowohl vor Ort als auch online.
    </p>
  </section>

  <!-- Geplante Kurse -->
  <section>
    <h2>Geplante Kurse</h2>
    <PriceTable rows={geplanteKurse} rowLabelOverride descLabel="Kurstyp" />
    <p>
      Mehr über die geplanten Kurse findest du auf der Seite
      <a href="/de/classes">Kurse</a>.
    </p>
  </section>

  <!-- 10er-Karte -->
  <section>
    <h2>10er-Karte</h2>
    <table>
      <thead>
        <tr>
          <th>Karte</th>
          <th>Preis</th>
          <th>Gültigkeit</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>10er-Karte</td>
          <PriceCell prices={pricing.class.tenPack} />
          <td>{pricing.class.tenPack.validity} Monate</td>
        </tr>
      </tbody>
    </table>
    <p>
      Eine flexible Option für alle, die in ihrem eigenen Rhythmus üben möchten. Die 10er-Karte bietet einen kleinen Preisvorteil, ohne Zeitdruck zu erzeugen.<br />
      Mit einer Gültigkeit von 18 Monaten hast du genügend Raum, deine Praxis entspannt zu gestalten — ganz ohne Stress oder das Gefühl, etwas verfallen zu lassen.
    </p>
  </section>

  <!-- Einzelunterricht -->
  <section>
    <h2>Privatstunden — Einzelunterricht</h2>
    <PriceTable rows={pricing.private} />
    <p>
      Mehr über Einzelunterricht findest du auf der Seite
      <a href="/de/private#einzelunterricht">Privat Yogapraxis</a>.
    </p>
  </section>

  <!-- Duet Sessions -->
  <section>
    <h2>Privatstunden — Duet (2 Personen)</h2>
    <PriceTable rows={pricing.duet} priceLabel="Preis (für 2 Personen)" />
    <p>
      Mehr über Duet-Unterricht findest du auf der Seite
      <a href="/de/private#duet">Privat Yogapraxis</a>.
    </p>
  </section>

  <!-- Small Group -->
  <section>
    <h2>Privatstunden — Kleingruppe (bis zu 4 Personen)</h2>
    <PriceTable rows={pricing.group} priceLabel="Preis (bis zu 4 Personen)" />
    <p>
      Mehr über Kleingruppen-Unterricht findest du auf der Seite
      <a href="/de/private#kleingruppe">Privat Yogapraxis</a>.
    </p>
  </section>

  <!-- Workshops -->
  <section>
    <h2>Workshops</h2>
    <PriceTable rows={pricing.workshop} />
    <p>
      Mehr über Aufbau und Inhalte der Workshops findest du auf der Seite
      <a href="/de/workshops">Workshops</a>.
    </p>
  </section>

  <!-- Payment Options -->
  <section>
    <h2>Zahlungsoptionen</h2>
    <p>
      Zahlungen können per SEPA, Zelle, Venmo, Wise oder per Kreditkarte über Mindbody erfolgen.
      Alle Details findest du auf der Seite <a href="/de/zahlung">Zahlungsoptionen</a>.
    </p>
  </section>

</BaseLayout>

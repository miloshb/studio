---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout lang="de" page="pricing" title="Preise – Studio Sun & Sea">
  <h1>Preise</h1>

  <!-- Geplante Kurse -->
  <section>
    <h2>Geplante Kurse</h2>
    <table>
      <thead>
        <tr>
          <th>Kurstyp</th>
          <th>Preis</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>60-90 Minuten</td>
          <td><strong>20 €</strong> / <strong>25 $</strong> / <strong>18 £</strong></td>
        </tr>
      </tbody>
    </table>
  </section>

  <!-- Einzelunterricht -->
  <section>
    <h2>Privatstunden — Einzelunterricht</h2>
    <table>
      <thead>
        <tr>
          <th>Dauer</th>
          <th>Preis</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>60 Minuten</td><td><strong>70 €</strong> / <strong>80 $</strong> / <strong>65 £</strong></td></tr>
        <tr><td>75 Minuten</td><td><strong>85 €</strong> / <strong>95 $</strong> / <strong>75 £</strong></td></tr>
        <tr><td>90 Minuten</td><td><strong>100 €</strong> / <strong>115 $</strong> / <strong>90 £</strong></td></tr>
        <tr><td>120 Minuten</td><td><strong>130 €</strong> / <strong>150 $</strong> / <strong>115 £</strong></td></tr>
      </tbody>
    </table>
  </section>

  <!-- Duet Sessions -->
  <section>
    <h2>Privatstunden — Duet (2 Personen)</h2>
    <table>
      <thead>
        <tr>
          <th>Dauer</th>
          <th>Preis (für 2 Personen)</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>60 Minuten</td><td><strong>100 €</strong> / <strong>115 $</strong> / <strong>90 £</strong></td></tr>
        <tr><td>75 Minuten</td><td><strong>120 €</strong> / <strong>135 $</strong> / <strong>105 £</strong></td></tr>
        <tr><td>90 Minuten</td><td><strong>140 €</strong> / <strong>160 $</strong> / <strong>125 £</strong></td></tr>
        <tr><td>120 Minuten</td><td><strong>180 €</strong> / <strong>205 $</strong> / <strong>160 £</strong></td></tr>
      </tbody>
    </table>
  </section>

  <!-- Small Group -->
  <section>
    <h2>Privatstunden — Kleingruppe (bis zu 4 Personen)</h2>
    <table>
      <thead>
        <tr>
          <th>Dauer</th>
          <th>Preis (bis zu 4 Personen)</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>60 Minuten</td><td><strong>140 €</strong> / <strong>160 $</strong> / <strong>125 £</strong></td></tr>
        <tr><td>75 Minuten</td><td><strong>165 €</strong> / <strong>190 $</strong> / <strong>150 £</strong></td></tr>
        <tr><td>90 Minuten</td><td><strong>190 €</strong> / <strong>220 $</strong> / <strong>175 £</strong></td></tr>
        <tr><td>120 Minuten</td><td><strong>240 €</strong> / <strong>275 $</strong> / <strong>220 £</strong></td></tr>
      </tbody>
    </table>
  </section>

  <!-- Workshops -->
  <section>
    <h2>Workshops</h2>
    <table>
      <thead>
        <tr>
          <th>Dauer</th>
          <th>Preis</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>2 Stunden</td><td><strong>55 €</strong> / <strong>65 $</strong> / <strong>50 £</strong></td></tr>
        <tr><td>3 Stunden</td><td><strong>75 €</strong> / <strong>85 $</strong> / <strong>65 £</strong></td></tr>
        <tr><td>4 Stunden</td><td><strong>95 €</strong> / <strong>110 $</strong> / <strong>85 £</strong></td></tr>
      </tbody>
    </table>
  </section>

  <!-- Payment Options -->
  <section>
    <h2>Zahlungsoptionen</h2>
    <p>
      Zahlungen können per SEPA, Zelle, Venmo, Wise oder per Kreditkarte über Mindbody erfolgen.
      Alle Details findest du auf der Seite <a href="/de/zahlung">Zahlungsoptionen</a>.
    </p>
  </section>

</BaseLayout>

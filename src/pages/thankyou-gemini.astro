---
// src/pages/thanks.astro
import { LANGS, ROUTES } from "../data/routes.js";

// 1. Identify the default language from your array architecture
const defaultLocale = LANGS[0];

// 2. Pre-calculate the fallback default URI on the server side
const defaultFallbackUri = ROUTES.thankYou.href[defaultLocale];

// 3. Serialize your localized URIs map into a clean JSON string for client injection
const localizedUrisMap = JSON.stringify(ROUTES.thankYou.href);
const supportedLanguages = JSON.stringify(LANGS);
---
<!DOCTYPE html>
<html lang={defaultLocale}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Redirecting...</title>

    <!-- Static Fallback redirect if JavaScript is disabled -->
    <noscript>
        <meta http-equiv="refresh" content={`2;url=${defaultFallbackUri}`} />
    </noscript>

    <!-- Define server variables securely using Astro's define:vars directive -->
    <script is:inline define:vars={{ localizedUrisMap, supportedLanguages, defaultLocale, defaultFallbackUri }}>
        // Parse the server data injected into the client context
        const uris = JSON.parse(localizedUrisMap);
        const supportedLocales = JSON.parse(supportedLanguages);

        // Detect user browser language preferences
        const userLanguages = navigator.languages || [navigator.language || defaultLocale];
        let targetLocale = defaultLocale;

        // Loop through browser languages to find a matching locale config
        for (const lang of userLanguages) {
            const shortLang = lang.split('-')[0].toLowerCase();
            if (supportedLocales.includes(shortLang)) {
                targetLocale = shortLang;
                break;
            }
        }

        // Dynamically extract the correct path based on the user's matched language key
        const baseRedirectUri = uris[targetLocale] || defaultFallbackUri;

        // Extract any incoming GET query parameters (e.g., "?source=booking")
        // window.location.search automatically returns an empty string "" if no parameters exist
        const queryString = window.location.search;

        // Append parameters safely to the localized base URL
        const finalRedirectUri = baseRedirectUri + queryString;

        // Perform the clean browser history replacement redirect
        window.location.assign(finalRedirectUri);
    </script>
</head>
<body>
    <div class="redirect-container">
        <p>Redirecting to your language version...</p>
        <p>Falls Sie nicht automatisch weitergeleitet werden, <a id="fallback-link" href={defaultFallbackUri}>klicken Sie bitte hier</a>.</p>
    </div>

    <script is:inline define:vars={{ localizedUrisMap, supportedLanguages, defaultLocale, defaultFallbackUri }}>
        // Ensure visual fallback links also retain the parameters for consistency
        const uris = JSON.parse(localizedUrisMap);
        const supportedLocales = JSON.parse(supportedLanguages);
        const userLanguages = navigator.languages || [navigator.language || defaultLocale];

        let targetLocale = defaultLocale;
        for (const lang of userLanguages) {
            const shortLang = lang.split('-')[0].toLowerCase();
            if (supportedLocales.includes(shortLang)) {
                targetLocale = shortLang;
                break;
            }
        }

        const baseRedirectUri = uris[targetLocale] || defaultFallbackUri;
        const queryString = window.location.search;

        document.getElementById('fallback-link').href = baseRedirectUri + queryString;
    </script>

    <style>
        .redirect-container {
            font-family: system-ui, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            color: #333;
            text-align: center;
        }
        a {
            color: #0066cc;
            text-decoration: underline;
        }
    </style>
</body>
</html>

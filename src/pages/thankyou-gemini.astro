---
// src/pages/thanks.astro
import { LANGS, ROUTES } from "../data/routes.js";
import { LANG_STORE_KEY } from "../data/constants.js";

// 1. Identify the default language from your array architecture
const defaultLocale = LANGS[0];

// 2. Pre-calculate the fallback default URI on the server side
const defaultFallbackUri = ROUTES.thankYou.href[defaultLocale];

// 3. Serialize your route maps and constants for client-side injection
const localizedUrisMap = JSON.stringify(ROUTES.thankYou.href);
const supportedLanguages = JSON.stringify(LANGS);
---
<!DOCTYPE html>
<html lang={defaultLocale}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Redirecting...</title>

    <!-- Static Fallback redirect if JavaScript is disabled -->
    <noscript>
        <meta http-equiv="refresh" content={`2;url=${defaultFallbackUri}`} />
    </noscript>

    <!-- Define server variables securely using Astro's define:vars directive -->
    <script is:inline define:vars={{ localizedUrisMap, supportedLanguages, defaultLocale, defaultFallbackUri, LANG_STORE_KEY }}>
        // Parse the server data injected into the client context
        const uris = JSON.parse(localizedUrisMap);
        const supportedLocales = JSON.parse(supportedLanguages);

        let targetLocale = null;

        // Priority 1: Check LocalStorage for an explicitly saved user preference
        try {
            const savedPref = localStorage.getItem(LANG_STORE_KEY);
            if (savedPref && supportedLocales.includes(savedPref.toLowerCase())) {
                targetLocale = savedPref.toLowerCase();
            }
        } catch (e) {
            // Guard against blocked cookies/localStorage privacy modes
            console.warn("Storage access denied:", e);
        }

        // Priority 2: Fall back to Browser Header configuration if no LocalStorage preference exists
        if (!targetLocale) {
            const userLanguages = navigator.languages || [navigator.language || defaultLocale];

            for (const lang of userLanguages) {
                // Safely extract language prefix (e.g., 'de-CH' -> 'de')
                const shortLang = lang.split('-')[0].toLowerCase();
                if (supportedLocales.includes(shortLang)) {
                    targetLocale = shortLang;
                    break;
                }
            }
        }

        // Priority 3: Fall back to system default if everything else fails
        if (!targetLocale) {
            targetLocale = defaultLocale;
        }

        // Extract localized base URL path and append query strings
        const baseRedirectUri = uris[targetLocale] || defaultFallbackUri;
        const queryString = window.location.search;
        const finalRedirectUri = baseRedirectUri + queryString;

        // Execute fast page replace
        window.location.assign(finalRedirectUri);
    </script>
</head>
<body>
    <div class="redirect-container">
        <p>Redirecting to your language version...</p>
        <p>Falls Sie nicht automatisch weitergeleitet werden, <a id="fallback-link" href={defaultFallbackUri}>klicken Sie bitte hier</a>.</p>
    </div>

    <script is:inline define:vars={{ localizedUrisMap, supportedLanguages, defaultLocale, defaultFallbackUri, LANG_STORE_KEY }}>
        // Match the fallback link destination perfectly with the prioritized target language
        const uris = JSON.parse(localizedUrisMap);
        const supportedLocales = JSON.parse(supportedLanguages);
        let targetLocale = null;

        try {
            const savedPref = localStorage.getItem(LANG_STORE_KEY);
            if (savedPref && supportedLocales.includes(savedPref.toLowerCase())) {
                targetLocale = savedPref.toLowerCase();
            }
        } catch (e) {}

        if (!targetLocale) {
            const userLanguages = navigator.languages || [navigator.language || defaultLocale];
            for (const lang of userLanguages) {
                const shortLang = lang.split('-')[0].toLowerCase();
                if (supportedLocales.includes(shortLang)) {
                    targetLocale = shortLang;
                    break;
                }
            }
        }

        if (!targetLocale) {
            targetLocale = defaultLocale;
        }

        const baseRedirectUri = uris[targetLocale] || defaultFallbackUri;
        const queryString = window.location.search;

        document.getElementById('fallback-link').href = baseRedirectUri + queryString;
    </script>

    <style>
        .redirect-container {
            font-family: system-ui, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            color: #333;
            text-align: center;
        }
        a {
            color: #0066cc;
            text-decoration: underline;
        }
    </style>
</body>
</html>

---
import { LANGS } from "../data/routes.js";
import { LANG_STORE_KEY } from "../data/config.ts";

const defaultLocale = LANGS[0];
---

<!DOCTYPE html>
<html lang={defaultLocale}>
  <head>
    <meta charset="UTF-8" />
    <title>Redirecting…</title>
    <noscript><meta http-equiv="refresh" content={`0;url=/${defaultLocale}/`} /></noscript>

    <script is:inline define:vars={{ LANGS, LANG_STORE_KEY }}>
      let targetLang = localStorage.getItem(LANG_STORE_KEY);

      if (!targetLang) {
        const browserLanguages = navigator.languages || [navigator.language || LANGS[0]];

        for (const lang of browserLanguages) {
          const shortCode = String(lang).split('-')[0].toLowerCase();
          if (LANGS.includes(shortCode)) {
            targetLang = shortCode;
            break;
          }
        }
      }

      targetLang = targetLang || LANGS[0];
      try {
        localStorage.setItem(LANG_STORE_KEY, targetLang);
      } catch (e) {
        // Guard against private browsing tracking blockers
      }
      window.location.replace(`/${targetLang}/`);
    </script>
  </head>
  <body>
  </body>
</html>

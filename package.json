{
  "name": "studio",
  "type": "module",
  "version": "0.3.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:sitemap": "linkinator ./dist/sitemap-index.xml --recurse",
    "test:links:run": "linkinator http://127.0.0.1:8080/en/ http://127.0.0.1:8080/de/ --recurse --links-to-skip https://mindbodyonline.com",
    "test:links": "npx http-server ./dist -p 8080 -c-1 & sleep 3 && npm run test:links:run && kill $!"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^6.4.4"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "sharp@0.34.5": true
  },
  "devDependencies": {
    "linkinator": "^7.6.1",
    "postcss-custom-media": "^12.0.1"
  }
}
